+  border-inline-start: 3px solid var(--sr-cyan);
+  margin: 12px 0;
+  padding: 4px 0 4px 14px;
+  color: var(--sr-text);
+}
+.sr-customhtml hr { border: 0; border-top: 1px solid var(--sr-line); margin: 16px 0; }
