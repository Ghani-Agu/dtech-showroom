+}
+.sr-customhtml h2 { font-size: 22px; }
+.sr-customhtml h3 { font-size: 18px; }
+.sr-customhtml h4 { font-size: 16px; }
+.sr-customhtml p { margin: 0 0 10px; }
+.sr-customhtml ul, .sr-customhtml ol { margin: 0 0 12px; padding-inline-start: 20px; }
+.sr-customhtml li { margin-bottom: 4px; }
+.sr-customhtml a { color: var(--sr-cyan); text-underline-offset: 3px; }
