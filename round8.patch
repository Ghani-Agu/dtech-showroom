+  border: 1px solid var(--sr-line);
+}
+.sr-customhtml iframe { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; }
+.sr-customhtml table {
+  width: 100%;
+  border-collapse: collapse;
+  margin: 12px 0;
+  font-size: 14px;
+}
+.sr-customhtml th, .sr-customhtml td {
+  border: 1px solid var(--sr-line);
+  padding: 9px 12px;
+  text-align: start;
+}
+.sr-customhtml th { color: var(--sr-text); background: color-mix(in srgb, var(--sr-cyan) 7%, transparent); }
