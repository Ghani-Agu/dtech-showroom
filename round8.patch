+}
+.brand-root .sr-nl-input::placeholder { color: var(--mute, #6a6a82); }
+.brand-root .sr-nl-btn { color: #fff; background: var(--teal-deep, #0f766e); }
+@media (max-width: 480px) {
+  .sr-nl-row { flex-direction: column; }
+  .sr-nl-btn { padding: 11px 18px; }
+}
