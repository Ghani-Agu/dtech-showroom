+.sr-pill-reset {
+  border-style: dashed;
+  background: transparent;
+  color: var(--sr-muted);
+}
+.sr-pill-reset:hover { color: var(--sr-text); background: transparent; }
+
+/* pagination links share the .sr-page look; disabled ends are inert spans */
+a.sr-page { text-decoration: none; }
+.sr-page.is-disabled {
+  opacity: 0.3;
+  cursor: not-allowed;
+  display: inline-grid;
+  place-items: center;
+}
+
+/* screen-reader-only helper (was only available as a Tailwind utility, which
+   the storefront CSS layer can't reach) */
+.sr-browser .sr-only,
+.sr-filterbar .sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
