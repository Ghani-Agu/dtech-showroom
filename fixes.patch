diff --git a/src/db/client.ts b/src/db/client.ts
index 258d316..fdb185a 100644
--- a/src/db/client.ts
+++ b/src/db/client.ts
@@ -9,10 +9,32 @@ const globalForDb = globalThis as unknown as {
 const connectionString =
   process.env.DATABASE_URL ?? 'postgres://noop:noop@localhost:5432/noop'
 
-const client = globalForDb.client ?? postgres(connectionString, { max: 1 })
+/**
+ * Serverless-safe Postgres client.
+ *
+ * On Vercel every warm instance keeps its own connection; without an idle
+ * timeout those pile up on Supabase's pooler until it refuses new ones, which
+ * surfaced as intermittent Better Auth "Failed to get session" /
+ * INTERNAL_SERVER_ERROR on /admin and /login.
+ *
+ *  - max: 1          → one connection per instance
+ *  - idle_timeout    → release the connection after 20s idle so pooler slots free up
+ *  - connect_timeout → fail fast instead of hanging when the pooler is saturated
+ *  - prepare: false  → pooler-safe (no stale prepared-statement errors; also works
+ *                      with Supabase's transaction pooler on port 6543)
+ *
+ * The client is cached on globalThis so it's reused across requests on the same
+ * instance (and across hot-reloads in dev).
+ */
+const client =
+  globalForDb.client ??
+  postgres(connectionString, {
+    max: 1,
+    idle_timeout: 20,
+    connect_timeout: 15,
+    prepare: false,
+  })
 
-if (process.env.NODE_ENV !== 'production') {
-  globalForDb.client = client
-}
+globalForDb.client = client
 
 export const db = drizzle(client, { schema })
