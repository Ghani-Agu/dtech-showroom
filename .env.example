# Database (Supabase Postgres)
# Use the TRANSACTION pooler port :6543 — port :5432 is session mode and is
# hard-capped at 15 live clients (prod + previews + local dev share them), which
# surfaces as EMAXCONNSESSION / "login bounces back to home". src/db/client.ts
# auto-upgrades :5432 -> :6543 as a safety net, but set it explicitly here and on Vercel.
# e.g. postgresql://USER:PASS@aws-1-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:6543/postgres"

# Public site URL — used for sitemap, robots, OG images, auth client
NEXT_PUBLIC_SITE_URL="https://dtech-showroom.vercel.app"

# Upstash Redis for inquiry-form rate limiting (optional in dev; required in prod)
# Get free credentials at https://upstash.com/console
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Better Auth (Phase 6)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend transactional email (Phase 6 — password reset)
# Get API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@d-techalgerie.com
RESEND_FROM_NAME=Dtech Algérie

# Cron routes — shared secret for GET /api/cron/campaigns (campaign scheduler)
# and GET /api/cron/keep-alive (daily +1 on keep_alive, so the free Supabase
# project is never auto-paused). Both are scheduled in vercel.json.
# (Vercel cron sends it automatically as Authorization: Bearer $CRON_SECRET;
#  external cron services can call ?key=<value>)
CRON_SECRET=

# Optional reply-to address on newsletter campaigns (e.g. contact@dtech.dz)
NEWSLETTER_REPLY_TO=

# Initial admin user (Phase 6 seed only — pnpm db:seed-admin)
INITIAL_ADMIN_EMAIL=admin@d-techalgerie.com
INITIAL_ADMIN_NAME=Dtech Admin
INITIAL_ADMIN_PASSWORD=

# D-Tech AI chat + GA4 — OPTIONAL fallbacks only.
# The admin (Réglages → Intégrations) is the source of truth and wins over
# these; they exist so a fresh deploy can ship pre-configured. Without them
# the chat launcher still renders, in handoff mode (WhatsApp / phone).
NEXT_PUBLIC_AI_CHAT_BASE_URL=
NEXT_PUBLIC_AI_CHAT_WIDGET_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare R2 — image storage (Phase 7d)
# Setup guide: cloudflare-r2-setup-guide.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dtech-showroom-images
R2_PUBLIC_URL=
