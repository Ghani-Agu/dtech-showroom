+.home-showcase-root .prod .info {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-height: 0;
+}
+.home-showcase-root .prod .info .name {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  min-height: 2.6em;
+}
+.home-showcase-root .prod .info .specs {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  min-height: 2.8em;
+}
+/* everything from the rating down is pinned to the bottom of the card */
+.home-showcase-root .prod .price-row { margin-top: auto; }
+.home-showcase-root .prod .card-actions { margin-top: 12px; }
