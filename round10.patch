+/* ── narrow screens: rail moves above the grid ───────────────────── */
+@media (max-width: 1000px) {
+  .sr-layout { grid-template-columns: minmax(0, 1fr); }
+  .sr-rail {
+    order: -1;
+    position: static;
+    max-height: none;
+    overflow: visible;
+    padding: 14px;
+  }
+  /* Category list becomes a horizontal scroller so it costs one row, not ten */
+  .sr-railcats {
+    flex-direction: row;
+    gap: 8px;
+    overflow-x: auto;
+    scrollbar-width: none;
+    padding-bottom: 2px;
+    /* bleed to the card edges so the row reads as scrollable */
+    margin-inline: -14px;
+    padding-inline: 14px;
+  }
+  .sr-railcats::-webkit-scrollbar { display: none; }
+  .sr-railcat {
+    flex: 0 0 auto;
+    border: 1px solid var(--sr-line2);
+    border-radius: 999px;
+    padding: 8px 14px;
+  }
+  .sr-railcat .lbl { white-space: nowrap; }
+}
+@media (max-width: 560px) {
+  .sr-resultbar { gap: 10px; }
+  .sr-resultbar .sr-select { width: 100%; }
+}
+
+/* subtle "working" state while the debounced search navigates */
+.sr-search-busy .sr-input { opacity: 0.72; }
+.sr-search-busy svg { animation: srPulse 1s ease-in-out infinite; }
+@keyframes srPulse { 50% { opacity: 0.35; } }
+@media (prefers-reduced-motion: reduce) {
+  .sr-search-busy svg { animation: none; }
+}
+
+/* Page header block — one spacing rhythm instead of per-element inline margins */
+.sr-pagehead { display: block; margin-bottom: clamp(22px, 3vw, 34px); }
+.sr-pagehead .sr-h1 { margin-top: 12px; }
+.sr-pagehead .sr-sub { margin-top: 10px; }
+
+/* The search field used to carry `flex: 1 1 220px` inline — written for the
+   old horizontal toolbar. Inside the vertical rail, flex-basis applies to the
+   BLOCK axis, so it rendered as a 220px-tall empty box with the icon floating
+   in the middle of it. Layout now belongs to the rail, not the component. */
+.sr-rail .sr-search { display: block; width: 100%; }
+.sr-rail .sr-search .sr-input {
+  width: 100%;
+  min-height: 40px;
+  padding-inline-start: 38px;
+}
+
+/* ═══════════ ROUND 10 — UI/UX POLISH ═══════════ */
+
+/* `aspect-ratio: 16/6` + `min-height: 220px` with no definite width let the
+   RATIO drive the width once min-height won: on a 390px phone the hero solved
+   to 220 × 16/6 = 587px and pushed the page sideways. Making the width
+   definite means the ratio is ignored instead of the container. */
+.sr-hero { width: 100%; }
+@media (max-width: 640px) {
+  .sr-hero { min-height: 168px; border-radius: 16px; }
+  .sr-hero .inner { padding: 18px 18px 20px; }
+}
+
+/* Form controls were 23px tall — below the 24px minimum target size, and
+   cramped next to 40px buttons. */
+.sr-input,
+.sr-textarea,
+.sr-select { min-height: 44px; }
+.sr-textarea { min-height: 96px; }
+
+/* Text links in dense rows need a real hit area, not just their line box. */
+.sr-crumbs a,
+.sr-footer a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 24px;
+}
+.sr-footer li { display: flex; }
+
+/* Consistent focus ring across every interactive element in the storefront —
+   several relied on the UA default, which is invisible on dark surfaces. */
+.sr-root a:focus-visible,
+.sr-root button:focus-visible,
+.sr-root select:focus-visible,
+.sr-root input:focus-visible,
+.sr-root textarea:focus-visible,
+.sr-browser a:focus-visible,
+.sr-browser button:focus-visible {
+  outline: 2px solid var(--sr-cyan);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
