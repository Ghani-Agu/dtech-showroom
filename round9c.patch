+++ b/src/components/home/partner-band.css
@@ -0,0 +1,195 @@
+/**
+ * partner-band.css — full-bleed partner spotlight.
+ *
+ * Self-contained on purpose: the band renders in BOTH storefront skins, so it
+ * can't rely on `--sr-*` (scoped to `.sr-root`) or on the classic/brand root
+ * palettes. Everything derives from the two `--pb-accent*` values the component
+ * sets inline, which means swapping the featured brand's colour needs no CSS
+ * change at all.
+ *
+ * Full-bleed comes free: in BOTH skins a homepage `<section>` is already
+ * full-width and the max-width wrapper lives INSIDE it. An earlier version used
+ * the `margin-inline: calc(50% - 50vw)` breakout trick on top of that, which
+ * was not only redundant but produced a horizontal scrollbar on /ar — in RTL
+ * the negative start-side margin grows scrollWidth instead of being clipped.
+ */
+
+.pb-band {
+  position: relative;
+  padding: clamp(48px, 6vw, 88px) 0;
+  color: #fff;
+  background:
+    radial-gradient(
+      120% 140% at 82% 12%,
+      color-mix(in srgb, #fff 16%, transparent) 0%,
+      transparent 55%
+    ),
+    linear-gradient(
+      135deg,
+      var(--pb-accent, #3b8fd4) 0%,
+      var(--pb-accent-deep, #1f6fb2) 100%
+    );
+  /* isolate so the radial highlight can't blend with page-level orbs */
+  isolation: isolate;
+}
+
+.pb-inner {
+  max-width: 1320px;
+  margin: 0 auto;
+  padding-inline: clamp(20px, 4vw, 40px);
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: clamp(28px, 4vw, 64px);
+  align-items: center;
+}
+
+/* ── left column ─────────────────────────────────────────────────── */
+
+.pb-badge-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: clamp(18px, 2.4vw, 28px);
+}
+.pb-logo {
+  display: grid;
+  place-items: center;
+  flex: 0 0 auto;
+  width: 48px;
+  height: 48px;
+  border-radius: 999px;
+  background: #fff;
+  box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.35);
+  overflow: hidden;
+}
+.pb-logo-mark {
+  font-weight: 800;
+  font-size: 17px;
+  letter-spacing: -0.03em;
+  color: var(--pb-accent-deep, #1f6fb2);
+}
+.pb-badge-text { display: flex; flex-direction: column; min-width: 0; }
+.pb-badge-text strong {
+  font-size: 14.5px;
+  font-weight: 700;
+  line-height: 1.25;
+}
+.pb-badge-text small {
+  font-size: 12.5px;
+  line-height: 1.35;
+  color: color-mix(in srgb, #fff 78%, transparent);
+}
+
+.pb-title {
+  margin: 0;
+  font-size: clamp(28px, 3.4vw, 46px);
+  line-height: 1.1;
+  letter-spacing: -0.03em;
+  font-weight: 800;
+  /* Near-black on the partner colour, matching the reference. Reads as the
+     brand's own typography rather than the site's. */
+  color: #0d1b26;
+  text-wrap: balance;
+}
+.pb-sub {
+  margin: clamp(14px, 1.8vw, 22px) 0 0;
+  max-width: 46ch;
+  font-size: clamp(14px, 1.15vw, 16px);
+  line-height: 1.65;
+  color: color-mix(in srgb, #fff 88%, transparent);
+}
+
+.pb-cta {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  margin-top: clamp(22px, 2.6vw, 32px);
+  padding: 12px 22px;
+  border-radius: 999px;
+  border: 1px solid color-mix(in srgb, #fff 55%, transparent);
+  background: color-mix(in srgb, #fff 10%, transparent);
+  color: #fff;
+  font-size: 14.5px;
+  font-weight: 600;
+  text-decoration: none;
+  backdrop-filter: blur(3px);
+  transition: background 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
+}
+.pb-cta:hover {
+  background: #fff;
+  border-color: #fff;
+  color: var(--pb-accent-deep, #1f6fb2);
+  transform: translateY(-1px);
+}
+.pb-cta:focus-visible {
+  outline: 2px solid #fff;
+  outline-offset: 3px;
+}
+[dir='rtl'] .pb-cta svg { transform: scaleX(-1); }
+
+/* ── tiles ───────────────────────────────────────────────────────── */
+
+.pb-tiles {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: clamp(12px, 1.4vw, 18px);
+}
+.pb-tile {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  height: 100%;
+  padding: clamp(16px, 1.8vw, 22px);
+  border-radius: 14px;
+  border: 1px solid color-mix(in srgb, #fff 30%, transparent);
+  background: color-mix(in srgb, #fff 12%, transparent);
+  color: #fff;
+  text-decoration: none;
+  transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
+}
+.pb-tile:hover {
+  background: color-mix(in srgb, #fff 22%, transparent);
+  border-color: color-mix(in srgb, #fff 62%, transparent);
+  transform: translateY(-2px);
+}
+.pb-tile:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
+.pb-tile-icon { margin-bottom: clamp(14px, 2vw, 26px); opacity: 0.95; }
+.pb-tile-title { font-size: 15px; font-weight: 700; line-height: 1.25; }
+.pb-tile-sub {
+  font-size: 12.5px;
+  line-height: 1.4;
+  color: color-mix(in srgb, #fff 80%, transparent);
+}
+
+/* ── responsive ──────────────────────────────────────────────────── */
+
+@media (max-width: 900px) {
+  .pb-inner { grid-template-columns: 1fr; gap: 32px; }
+  .pb-sub { max-width: none; }
+}
+@media (max-width: 600px) {
+  /* Keep the 2×2 shape; just tighten it. Stacking to one column made the band
+     ~940px tall on a 390px phone, which is longer than the viewport. */
+  .pb-tile { padding: 14px; border-radius: 12px; }
+  .pb-tile-icon { margin-bottom: 10px; }
+  .pb-tile-title { font-size: 13.5px; }
+  .pb-tile-sub { font-size: 11.5px; }
+}
+@media (max-width: 340px) {
+  .pb-tiles { grid-template-columns: 1fr; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .pb-cta,
+  .pb-tile { transition: none; }
+  .pb-cta:hover,
+  .pb-tile:hover { transform: none; }
+}
+
+/* Dark-on-accent stays legible if a future partner colour is very dark. */
+@supports (color: color-contrast(#000 vs #fff, #000)) {
+  .pb-title { color: color-contrast(var(--pb-accent) vs #0d1b26, #ffffff); }
+}
diff --git a/src/server/partner-band.ts b/src/server/partner-band.ts
new file mode 100644
index 0000000..bad3ea4
--- /dev/null
+++ b/src/server/partner-band.ts
@@ -0,0 +1,108 @@
+import 'server-only'
+
+import { imgOr } from '@/lib/img'
+import type { getAllProducts, getAllBrands } from '@/server/queries'
+import type { PartnerIconKind, PartnerTile } from '@/components/home/PartnerBand'
+
+/**
+ * Data for the homepage partner spotlight.
+ *
+ * The tiles are DERIVED from the live catalogue — the featured brand's biggest
+ * product families, with real counts — rather than hand-written. That means a
+ * tile can never advertise a family the brand no longer stocks, and can never
+ * link to an empty filtered page. Reseeding or archiving products updates the
+ * band on the next request.
+ */
+
+type ProductsRaw = Awaited<ReturnType<typeof getAllProducts>>
+type BrandsRaw = Awaited<ReturnType<typeof getAllBrands>>
+
+/** Featured partner. Change the slug here to spotlight a different brand. */
+export const PARTNER_BRAND_SLUG = 'hp'
+
+/** Partner brand colours — HP's blue, matching their own identity. */
+const PARTNER_COLORS: Record<string, { accent: string; deep: string }> = {
+  hp: { accent: '#3d92d9', deep: '#0b6bb5' },
+  asus: { accent: '#3b4a8c', deep: '#1d2555' },
+  dell: { accent: '#1a7fd4', deep: '#0f4c8a' },
+  epson: { accent: '#2b4ea2', deep: '#16306b' },
+  lenovo: { accent: '#d6373b', deep: '#8f1f22' },
+  'tp-link': { accent: '#3aa0d8', deep: '#16688f' },
+  canon: { accent: '#cf2027', deep: '#8b1216' },
+}
+const DEFAULT_COLORS = { accent: '#3d92d9', deep: '#0b6bb5' }
+
+const CATEGORY_ICON: Record<string, PartnerIconKind> = {
+  laptops: 'laptop',
+  monitors: 'monitor',
+  'all-in-one': 'aio',
+  desktops: 'desktop',
+  printers: 'printer',
+  scanners: 'printer',
+  projectors: 'printer',
+  consumables: 'printer',
+  networking: 'network',
+  gaming: 'gaming',
+  'graphics-cards': 'gaming',
+  tablets: 'laptop',
+}
+
+export interface PartnerBandData {
+  brandSlug: string
+  brandName: string
+  logoPath: string | null
+  accent: string
+  accentDeep: string
+  productCount: number
+  tiles: PartnerTile[]
+}
+
+export function buildPartnerBand(
+  products: ProductsRaw,
+  brands: BrandsRaw,
+  brandSlug: string = PARTNER_BRAND_SLUG,
+  /** How many family tiles to show. The layout is a 2×2 grid. */
+  tileCount = 4
+): PartnerBandData | null {
+  const brand = brands.find((b) => b.slug === brandSlug)
+  if (!brand) return null
+
+  const mine = products.filter((p) => p.brand.slug === brandSlug)
+  if (mine.length === 0) return null
+
+  // Group into categories, then take the biggest families.
+  const byCategory = new Map<string, { name: string; count: number }>()
+  for (const p of mine) {
+    const slug = p.category.slug
+    const entry = byCategory.get(slug)
+    if (entry) entry.count++
+    else byCategory.set(slug, { name: p.category.name, count: 1 })
+  }
+
+  const tiles: PartnerTile[] = [...byCategory.entries()]
+    .sort(
+      // Count desc, then slug asc so the order is stable across requests and
+      // locales — an unstable tie-break would reshuffle the grid on refresh.
+      (a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0])
+    )
+    .slice(0, tileCount)
+    .map(([slug, { name, count }]) => ({
+      categorySlug: slug,
+      title: `${brand.name} ${name}`,
+      // Filled in by the caller, which has the translator.
+      sub: String(count),
+      icon: CATEGORY_ICON[slug] ?? 'parts',
+    }))
+
+  const colors = PARTNER_COLORS[brandSlug] ?? DEFAULT_COLORS
+
+  return {
+    brandSlug,
+    brandName: brand.name,
+    logoPath: brand.logoPath ? imgOr(brand.logoPath) : null,
+    accent: colors.accent,
+    accentDeep: colors.deep,
+    productCount: mine.length,
+    tiles,
+  }
+}
