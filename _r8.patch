+  --color-text-disabled: #8b938f;
+  --color-accent: #0a7057;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+   ADMIN responsive nav — the sidebar was a fixed 268px rail that
+   crushed content on tablets/phones. Below 1024px it becomes an
+   off-canvas drawer opened by a floating menu button (with scrim +
+   focus trap in AdminSidebar). Desktop is unchanged.
+   ═══════════════════════════════════════════════════════════════ */
+.admin-navfab, .admin-navclose, .admin-navscrim { display: none; }
+@media (max-width: 1023px) {
+  .admin-shell aside.glass-surface {
+    position: fixed; inset-block: 0; inset-inline-start: 0;
+    z-index: 60; width: 280px; max-width: 86vw;
+    transform: translateX(-100%);
+    transition: transform 0.28s var(--admin-ease, ease);
+  }
+  [dir='rtl'] .admin-shell aside.glass-surface { transform: translateX(100%); }
+  .admin-shell aside.glass-surface[data-open='true'] { transform: translateX(0); }
+  .admin-navfab {
+    display: inline-grid; place-items: center;
+    position: fixed; inset-inline-start: 16px; inset-block-end: 16px; z-index: 56;
+    width: 52px; height: 52px; border-radius: 999px;
+    background: var(--c-mint); color: var(--admin-on-accent);
+    border: 1px solid color-mix(in oklab, var(--c-mint) 60%, transparent);
+    box-shadow: 0 10px 26px -8px color-mix(in oklab, var(--c-mint) 55%, transparent);
+  }
+  .admin-navclose {
+    display: inline-grid; place-items: center;
+    position: absolute; inset-block-start: 14px; inset-inline-end: 14px; z-index: 2;
+    width: 40px; height: 40px; border-radius: 999px;
+    color: var(--admin-text-secondary); background: var(--admin-soft);
+    border: 1px solid var(--admin-glass-border);
+  }
+  .admin-navscrim[data-open='true'] {
+    display: block; position: fixed; inset: 0; z-index: 58;
+    background: var(--admin-overlay);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .admin-shell aside.glass-surface { transition: none; }
+}
